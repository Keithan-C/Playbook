<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Governance Playbook · ADAS Teams · EU AI Act — Premium Edition</title>
  <!-- ─────────────────────────────────────────────
       FONTS
  ───────────────────────────────────────────── -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <style>
    /* ═══════════════════════════════════════════════
       DESIGN TOKENS
    ═══════════════════════════════════════════════ */
    :root {
      --ink:        #0d1117;
      --ink-soft:   #3a4250;
      --ink-muted:  #6b7685;
      --surface:    #f5f6f8;
      --card:       #ffffff;
      --border:     #e2e5ea;

      --blue:       #1a6ef5;
      --blue-pale:  #e8f0ff;
      --green:      #1ca96a;
      --green-pale: #e6f8ef;
      --amber:      #d97706;
      --amber-pale: #fff4e0;
      --red:        #dc2626;
      --red-pale:   #fef2f2;
      --orange:     #ea580c;
      --orange-pale:#fff1ec;

      --accent:     #1a6ef5;
      --accent-2:   #0ea66a;

      --radius:     10px;
      --radius-lg:  16px;
      --shadow:     0 2px 12px rgba(13,17,23,.07);
      --shadow-lg:  0 6px 32px rgba(13,17,23,.12);

      --font-head:  'Syne', sans-serif;
      --font-body:  'DM Sans', sans-serif;
      --font-mono:  'DM Mono', monospace;
    }

    /* ═══════════════════════════════════════════════
       RESET & BASE
    ═══════════════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }
    body {
      font-family: var(--font-body);
      background: var(--surface);
      color: var(--ink);
      line-height: 1.65;
    }
    a { color: var(--blue); text-decoration: none; }
    a:hover { text-decoration: underline; }
    img { max-width: 100%; border-radius: var(--radius); display: block; }
    h1,h2,h3,h4,h5 { font-family: var(--font-head); line-height: 1.2; }

    /* ═══════════════════════════════════════════════
       LAYOUT HELPERS
    ═══════════════════════════════════════════════ */
    .container  { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
    .section    { padding: 72px 0; }
    .section + .section { border-top: 1px solid var(--border); }
    .grid-2     { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .grid-3     { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
    .card       { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 28px; box-shadow: var(--shadow); }
    .chip       { display: inline-flex; align-items: center; gap: 6px; font-size: .78rem; font-weight: 600; padding: 4px 10px; border-radius: 20px; letter-spacing: .03em; }
    .chip-blue  { background: var(--blue-pale);   color: var(--blue);  }
    .chip-green { background: var(--green-pale);  color: var(--green); }
    .chip-red   { background: var(--red-pale);    color: var(--red);   }
    .chip-amber { background: var(--amber-pale);  color: var(--amber); }
    .chip-orange{ background: var(--orange-pale); color: var(--orange);}
    .mono       { font-family: var(--font-mono); font-size: .85em; }
    .label      { font-size: .72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); }
    .divider    { border: none; border-top: 1px solid var(--border); margin: 32px 0; }

    /* ═══════════════════════════════════════════════
       TOP NAV
    ═══════════════════════════════════════════════ */
    #topnav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(245,246,248,.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      height: 56px; display: flex; align-items: center;
    }
    #topnav .container { display: flex; align-items: center; justify-content: space-between; width: 100%; }
    .nav-logo { font-family: var(--font-head); font-size: 1rem; font-weight: 800; display: flex; align-items: center; gap: 8px; color: var(--ink); }
    .nav-logo .dot { width: 10px; height: 10px; background: var(--blue); border-radius: 50%; }
    .nav-links { display: flex; gap: 4px; flex-wrap: wrap; }
    .nav-links a {
      font-size: .8rem; font-weight: 500; color: var(--ink-soft);
      padding: 6px 10px; border-radius: 6px; transition: background .15s, color .15s;
    }
    .nav-links a:hover { background: var(--blue-pale); color: var(--blue); text-decoration: none; }

    /* ═══════════════════════════════════════════════
       HERO / LANDING
    ═══════════════════════════════════════════════ */
    #hero {
      background: var(--ink);
      color: #fff;
      padding: 96px 0 80px;
      position: relative;
      overflow: hidden;
    }
    #hero::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 70% 60% at 80% 30%, #1a3a7a44, transparent),
                  radial-gradient(ellipse 50% 50% at 20% 70%, #0a3d2a33, transparent);
    }
    #hero .container { position: relative; }
    .hero-eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
    .hero-tag {
      font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
      background: rgba(26,110,245,.25); color: #7fb4ff;
      padding: 5px 12px; border-radius: 20px; border: 1px solid rgba(26,110,245,.4);
    }
    .hero-date { font-size: .8rem; color: #8899aa; }
    #hero h1 {
      font-size: clamp(2.4rem, 5vw, 3.6rem);
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 20px;
      max-width: 720px;
    }
    #hero h1 em { font-style: normal; color: #6eb5ff; }
    .hero-sub {
      font-size: 1.05rem; color: #9aacbd; max-width: 600px; margin-bottom: 36px;
    }
    .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--font-body); font-size: .9rem; font-weight: 600;
      padding: 12px 22px; border-radius: 8px; cursor: pointer;
      border: none; transition: all .18s;
    }
    .btn-primary { background: var(--blue); color: #fff; }
    .btn-primary:hover { background: #1558d0; text-decoration: none; color: #fff; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #c5d5e8; border: 1px solid rgba(255,255,255,.14); }
    .btn-ghost:hover { background: rgba(255,255,255,.14); text-decoration: none; color: #fff; }
    .hero-stats {
      margin-top: 56px;
      display: flex; gap: 40px; flex-wrap: wrap;
      padding-top: 36px; border-top: 1px solid rgba(255,255,255,.1);
    }
    .stat-item {}
    .stat-num { font-family: var(--font-head); font-size: 2rem; font-weight: 800; color: #fff; }
    .stat-label { font-size: .8rem; color: #778899; margin-top: 2px; }

    /* deadline banner */
    .deadline-banner {
      background: linear-gradient(90deg, #7c1212, #b91c1c);
      color: #fff; text-align: center;
      font-size: .85rem; font-weight: 500;
      padding: 10px 24px;
      display: flex; align-items: center; justify-content: center; gap: 10px;
    }
    .deadline-banner strong { font-weight: 700; }
    .pulse { display: inline-block; width: 8px; height: 8px; background: #fca5a5; border-radius: 50%; animation: pulse 1.4s infinite; }
    @keyframes pulse { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.6);opacity:.5} }

    /* ═══════════════════════════════════════════════
       SECTION HEADERS
    ═══════════════════════════════════════════════ */
    .section-head { margin-bottom: 40px; }
    .section-head .label { margin-bottom: 10px; }
    .section-head h2 { font-size: clamp(1.7rem, 3vw, 2.2rem); margin-bottom: 12px; }
    .section-head p { color: var(--ink-soft); max-width: 620px; font-size: 1.01rem; }

    /* ═══════════════════════════════════════════════
       OVERVIEW – PILLAR CARDS
    ═══════════════════════════════════════════════ */
    .pillar-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
    .pillar-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 24px;
      box-shadow: var(--shadow); position: relative; overflow: hidden;
    }
    .pillar-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    }
    .pillar-card.blue::before  { background: var(--blue);  }
    .pillar-card.green::before { background: var(--green); }
    .pillar-card.red::before   { background: var(--red);   }
    .pillar-card.amber::before { background: var(--amber); }
    .pillar-icon {
      width: 42px; height: 42px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem; margin-bottom: 16px;
    }
    .pillar-icon.blue  { background: var(--blue-pale);  }
    .pillar-icon.green { background: var(--green-pale); }
    .pillar-icon.red   { background: var(--red-pale);   }
    .pillar-icon.amber { background: var(--amber-pale); }
    .pillar-card h3 { font-size: 1.02rem; margin-bottom: 8px; }
    .pillar-card p  { font-size: .88rem; color: var(--ink-soft); }

    /* timeline – article refs */
    .timeline { position: relative; padding-left: 28px; }
    .timeline::before {
      content: ''; position: absolute; left: 8px; top: 4px; bottom: 4px;
      width: 2px; background: var(--border);
    }
    .tl-item { position: relative; margin-bottom: 20px; }
    .tl-item::before {
      content: ''; position: absolute; left: -24px; top: 6px;
      width: 10px; height: 10px; border-radius: 50%;
      background: var(--blue); border: 2px solid var(--card);
      box-shadow: 0 0 0 2px var(--blue);
    }
    .tl-item .tl-tag { font-family: var(--font-mono); font-size: .75rem; color: var(--blue); font-weight: 500; margin-bottom: 4px; }
    .tl-item p { font-size: .9rem; color: var(--ink-soft); }

    /* ═══════════════════════════════════════════════
       RISK CLASSIFICATION TABLE
    ═══════════════════════════════════════════════ */
    .risk-table { width: 100%; border-collapse: collapse; font-size: .88rem; }
    .risk-table th {
      background: var(--ink); color: #fff;
      font-family: var(--font-head); font-size: .8rem;
      letter-spacing: .06em; text-align: left;
      padding: 12px 16px;
    }
    .risk-table th:first-child { border-radius: 8px 0 0 0; }
    .risk-table th:last-child  { border-radius: 0 8px 0 0; }
    .risk-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
    .risk-table tr:last-child td { border-bottom: none; }
    .risk-table tr:hover td { background: #f9fafc; }
    .risk-table tbody tr:nth-child(odd) td { background: #fcfcfd; }
    .risk-table tbody tr:nth-child(odd):hover td { background: #f4f6fa; }
    .risk-level {
      display: inline-flex; align-items: center; gap: 5px;
      font-weight: 700; font-size: .78rem; padding: 3px 9px;
      border-radius: 20px;
    }
    .rl-critical { background: #fee2e2; color: #991b1b; }
    .rl-high     { background: #ffedd5; color: #9a3412; }
    .rl-medium   { background: #fef9c3; color: #854d0e; }
    .rl-low      { background: #dcfce7; color: #166534; }

    /* ═══════════════════════════════════════════════
       DOCUMENTATION REQUIREMENTS
    ═══════════════════════════════════════════════ */
    .doc-req-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .doc-req-card {
      border: 1px solid var(--border); border-radius: var(--radius-lg);
      background: var(--card); overflow: hidden; box-shadow: var(--shadow);
    }
    .doc-req-header {
      padding: 16px 20px; display: flex; align-items: center; gap: 12px;
    }
    .doc-req-header .icon { font-size: 1.4rem; }
    .doc-req-header h3 { font-size: .98rem; }
    .doc-req-body { padding: 0 20px 20px; }
    .doc-req-body ul { list-style: none; }
    .doc-req-body li {
      font-size: .86rem; color: var(--ink-soft); padding: 7px 0;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: flex-start; gap: 8px;
    }
    .doc-req-body li:last-child { border-bottom: none; }
    .doc-req-body li::before { content: '→'; color: var(--blue); flex-shrink: 0; margin-top: 1px; }

    /* article badge */
    .art-badge {
      font-family: var(--font-mono); font-size: .72rem; font-weight: 500;
      background: var(--blue-pale); color: var(--blue);
      padding: 2px 7px; border-radius: 4px; margin-left: auto; white-space: nowrap;
    }

    /* ═══════════════════════════════════════════════
       SPLIT COMPARISON
    ═══════════════════════════════════════════════ */
    .compare-wrap {
      display: grid; grid-template-columns: 1fr 1fr; gap: 0;
      border: 1px solid var(--border); border-radius: var(--radius-lg);
      overflow: hidden; box-shadow: var(--shadow-lg);
    }
    .compare-col { padding: 32px; }
    .compare-col.have { background: var(--card); }
    .compare-col.need { background: #0d1117; color: #c5d5e8; }
    .compare-col h3 {
      font-size: 1rem; margin-bottom: 20px;
      display: flex; align-items: center; gap: 10px;
    }
    .compare-col.need h3 { color: #fff; }
    .compare-item {
      display: flex; gap: 12px; padding: 10px 0;
      border-bottom: 1px solid rgba(0,0,0,.07); font-size: .88rem;
    }
    .compare-col.need .compare-item { border-color: rgba(255,255,255,.08); color: #9aacbd; }
    .compare-item:last-child { border-bottom: none; }
    .cmp-icon { font-size: 1rem; flex-shrink: 0; margin-top: 2px; }
    .compare-gap {
      background: #fee2e2; border-radius: 6px; padding: 8px 12px;
      font-size: .82rem; color: #991b1b; font-weight: 500;
      margin-top: 8px;
    }
    .compare-ok {
      background: var(--green-pale); border-radius: 6px; padding: 8px 12px;
      font-size: .82rem; color: var(--green); font-weight: 500;
      margin-top: 8px;
    }
    .compare-divider {
      display: flex; align-items: center; justify-content: center;
      background: var(--ink); color: #fff; width: 48px;
      font-family: var(--font-head); font-size: .7rem; font-weight: 700;
      letter-spacing: .1em; writing-mode: vertical-rl;
      text-orientation: mixed; flex-shrink: 0;
    }

    /* ═══════════════════════════════════════════════
       GOVERNANCE WORKFLOW
    ═══════════════════════════════════════════════ */
    .flow-stages { display: flex; gap: 0; overflow-x: auto; padding-bottom: 8px; }
    .flow-stage {
      flex: 1; min-width: 180px;
      border: 1px solid var(--border); border-right: none;
      background: var(--card); padding: 20px;
      position: relative; cursor: pointer;
      transition: background .15s;
    }
    .flow-stage:first-child { border-radius: var(--radius) 0 0 0; }
    .flow-stage:last-child  { border-right: 1px solid var(--border); border-radius: 0 var(--radius) 0 0; }
    .flow-stage.active { background: var(--blue); color: #fff; border-color: var(--blue); }
    .flow-stage.active .stage-num { background: rgba(255,255,255,.2); color: #fff; }
    .flow-stage.active .stage-name { color: #fff; }
    .flow-stage.active .stage-sub  { color: rgba(255,255,255,.7); }
    .flow-stage:hover:not(.active) { background: var(--blue-pale); }
    .stage-num {
      background: var(--blue-pale); color: var(--blue);
      width: 28px; height: 28px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-head); font-size: .78rem; font-weight: 700;
      margin-bottom: 10px;
    }
    .stage-name { font-family: var(--font-head); font-size: .9rem; font-weight: 700; margin-bottom: 4px; }
    .stage-sub  { font-size: .75rem; color: var(--ink-muted); }
    .flow-arrow {
      display: flex; align-items: center; padding: 0 4px;
      color: var(--ink-muted); font-size: .9rem; flex-shrink: 0;
    }

    /* stage detail panel */
    .stage-detail {
      border: 1px solid var(--border); border-top: none;
      border-radius: 0 0 var(--radius) var(--radius);
      background: var(--card); padding: 28px;
      display: none;
    }
    .stage-detail.visible { display: block; }
    .stage-detail h4 { font-size: 1rem; margin-bottom: 16px; }
    .checkpoint-list { list-style: none; }
    .checkpoint-list li {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 9px 0; border-bottom: 1px solid var(--border); font-size: .88rem;
    }
    .checkpoint-list li:last-child { border-bottom: none; }
    .ck-icon { flex-shrink: 0; font-size: 1rem; }
    .ck-text strong { display: block; margin-bottom: 2px; }
    .ck-text span { color: var(--ink-muted); font-size: .82rem; }

    /* ═══════════════════════════════════════════════
       COMPLIANCE TOOLS
    ═══════════════════════════════════════════════ */
    .tool-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow);
      display: flex; gap: 18px; align-items: flex-start;
      transition: box-shadow .2s, transform .2s;
    }
    .tool-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
    .tool-logo {
      width: 48px; height: 48px; border-radius: 10px;
      background: var(--blue-pale); display: flex; align-items: center;
      justify-content: center; font-size: 1.5rem; flex-shrink: 0;
    }
    .tool-info h3 { font-size: .95rem; margin-bottom: 4px; }
    .tool-info p  { font-size: .84rem; color: var(--ink-soft); margin-bottom: 10px; }
    .tool-tags { display: flex; gap: 6px; flex-wrap: wrap; }

    /* ═══════════════════════════════════════════════
       RACI TABLE
    ═══════════════════════════════════════════════ */
    .raci-table { width: 100%; border-collapse: collapse; font-size: .86rem; }
    .raci-table th {
      background: var(--ink); color: #fff; padding: 11px 14px;
      font-family: var(--font-head); font-size: .78rem; letter-spacing: .05em;
      text-align: left;
    }
    .raci-table th:first-child { border-radius: 8px 0 0 0; }
    .raci-table th:last-child  { border-radius: 0 8px 0 0; }
    .raci-table td { padding: 10px 14px; border-bottom: 1px solid var(--border); }
    .raci-table tr:last-child td { border-bottom: none; }
    .raci-table tr:hover td { background: #f9fafc; }
    .raci-cell {
      display: inline-flex; align-items: center; justify-content: center;
      width: 30px; height: 30px; border-radius: 6px;
      font-weight: 700; font-size: .8rem; font-family: var(--font-head);
    }
    .r-R { background: var(--blue-pale);   color: var(--blue);  }
    .r-A { background: var(--red-pale);    color: var(--red);   }
    .r-C { background: var(--amber-pale);  color: var(--amber); }
    .r-I { background: var(--green-pale);  color: var(--green); }
    .r-x { background: #f3f4f6; color: #9ca3af; }

    /* legend */
    .raci-legend { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 14px; }
    .raci-legend span { display: flex; align-items: center; gap: 6px; font-size: .82rem; color: var(--ink-soft); }

    /* ═══════════════════════════════════════════════
       COLLAPSIBLE SECTIONS (JS-powered)
    ═══════════════════════════════════════════════ */
    .collapsible-trigger {
      width: 100%; background: none; border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0; font-family: inherit; text-align: left;
    }
    .collapsible-trigger:focus-visible { outline: 2px solid var(--blue); border-radius: 4px; }
    .collapse-icon { transition: transform .25s; font-size: 1.2rem; color: var(--ink-muted); flex-shrink: 0; }
    .collapsible-trigger.open .collapse-icon { transform: rotate(180deg); }
    .collapsible-body { overflow: hidden; max-height: 0; transition: max-height .35s ease, opacity .25s; opacity: 0; }
    .collapsible-body.open { opacity: 1; }

    /* ═══════════════════════════════════════════════
       ALERT / INFO BOXES
    ═══════════════════════════════════════════════ */
    .alert {
      border-radius: var(--radius); padding: 14px 18px;
      display: flex; gap: 12px; font-size: .88rem;
      border: 1px solid transparent;
    }
    .alert-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: 1px; }
    .alert-info    { background: var(--blue-pale);   border-color: #bdd7ff; color: #1a3f8a; }
    .alert-warn    { background: var(--amber-pale);  border-color: #fcd27a; color: #7a4a08; }
    .alert-success { background: var(--green-pale);  border-color: #86efb5; color: #14593a; }
    .alert-danger  { background: var(--red-pale);    border-color: #fca5a5; color: #7f1d1d; }

    /* ═══════════════════════════════════════════════
       TOOLTIP
    ═══════════════════════════════════════════════ */
    [data-tooltip] { position: relative; cursor: help; border-bottom: 1px dashed var(--blue); }
    [data-tooltip]::after {
      content: attr(data-tooltip);
      position: absolute; bottom: 130%; left: 50%; transform: translateX(-50%);
      background: #1a1f2e; color: #e2e8f0;
      font-size: .76rem; font-family: var(--font-body); font-weight: 400;
      padding: 7px 12px; border-radius: 6px; white-space: nowrap;
      pointer-events: none; opacity: 0; transition: opacity .18s;
      max-width: 240px; white-space: normal; text-align: center;
      box-shadow: 0 4px 12px rgba(0,0,0,.3);
      z-index: 200;
    }
    [data-tooltip]:hover::after { opacity: 1; }

    /* ═══════════════════════════════════════════════
       PROGRESS BAR (visual compliance readiness)
    ═══════════════════════════════════════════════ */
    .readiness-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 24px; }
    .readiness-item {}
    .readiness-header { display: flex; justify-content: space-between; font-size: .84rem; margin-bottom: 6px; }
    .readiness-header span:first-child { color: var(--ink-soft); font-weight: 500; }
    .readiness-header span:last-child  { font-weight: 700; }
    .progress-bar { height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; }
    .progress-fill { height: 100%; border-radius: 4px; transition: width 1s ease; }
    .pf-green  { background: var(--green); }
    .pf-amber  { background: var(--amber); }
    .pf-red    { background: var(--red);   }
    .pf-blue   { background: var(--blue);  }

    /* ═══════════════════════════════════════════════
       FOOTER
    ═══════════════════════════════════════════════ */
    footer {
      background: var(--ink); color: #778899;
      padding: 48px 0; font-size: .84rem;
    }
    footer .container { display: flex; flex-direction: column; gap: 20px; }
    .footer-top { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px; }
    .footer-brand { font-family: var(--font-head); font-size: 1rem; color: #fff; font-weight: 800; }
    .footer-note { max-width: 520px; line-height: 1.6; }
    .footer-links { display: flex; gap: 20px; flex-wrap: wrap; }
    .footer-links a { color: #778899; }
    .footer-links a:hover { color: #fff; }
    footer hr { border: none; border-top: 1px solid rgba(255,255,255,.08); }
    .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }

    /* ═══════════════════════════════════════════════
       RESPONSIVE
    ═══════════════════════════════════════════════ */
    @media (max-width: 768px) {
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
      .compare-wrap { grid-template-columns: 1fr; }
      .compare-divider { writing-mode: horizontal-tb; width: 100%; height: 40px; }
      .flow-stages { flex-direction: column; }
      .flow-stage:first-child { border-radius: var(--radius) var(--radius) 0 0; }
      .flow-stage:last-child  { border-right: 1px solid var(--border); border-radius: 0; }
      .nav-links { display: none; }
      .hero-stats { gap: 24px; }
    }

    /* ═══════════════════════════════════════════════
       SCROLL REVEAL (lightweight)
    ═══════════════════════════════════════════════ */
    .reveal {
      opacity: 0; transform: translateY(18px);
      transition: opacity .5s ease, transform .5s ease;
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* placeholder image style */
    .placeholder-img {
      background: linear-gradient(135deg, #e8ecf2 0%, #dde3ed 100%);
      border: 2px dashed #c8d0dc; border-radius: var(--radius);
      display: flex; align-items: center; justify-content: center;
      color: #8a96a8; font-size: .82rem; font-family: var(--font-mono);
      text-align: center; padding: 24px;
    }


    /* ══════════════════════════════════════════════
       FREE / PREMIUM TIER SYSTEM  [v2]
    ══════════════════════════════════════════════ */

    /* Tier badges */
    .tier-badge {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: .68rem; font-weight: 700; letter-spacing: .08em;
      text-transform: uppercase; padding: 3px 10px; border-radius: 20px;
      vertical-align: middle; margin-left: 10px;
    }
    .tier-free    { background: var(--green-pale); color: var(--green); border: 1px solid #86efb5; }
    .tier-premium { background: #fffbeb; color: #92400e; border: 1px solid #fcd34d; }

    /* Gold palette */
    :root {
      --gold:        #92400e;
      --gold-bright: #f59e0b;
      --gold-pale:   #fffbeb;
      --gold-border: #fcd34d;
    }

    /* Premium gate wrapper */
    .premium-gate {
      position: relative; border-radius: var(--radius-lg); overflow: hidden;
      border: 2px solid var(--gold-border);
      box-shadow: 0 0 0 4px rgba(245,166,35,.08);
      margin-top: 0;
    }
    .premium-content {
      filter: blur(4px); user-select: none; pointer-events: none; opacity: .55;
    }
    .premium-overlay {
      position: absolute; inset: 0;
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; gap: 14px;
      background: rgba(255,251,235,.85); backdrop-filter: blur(2px);
      padding: 32px; text-align: center; z-index: 10;
    }
    .premium-overlay .lock-icon { font-size: 2.2rem; line-height: 1; }
    .premium-overlay h4 { font-family: var(--font-head); font-size: 1.1rem; color: var(--ink); margin-bottom: 4px; }
    .premium-overlay p  { font-size: .86rem; color: var(--ink-soft); max-width: 360px; line-height: 1.55; }
    .premium-header-strip {
      background: linear-gradient(90deg, #fef3c7, #fde68a);
      border-bottom: 1px solid var(--gold-border);
      padding: 8px 20px;
      display: flex; align-items: center; gap: 8px;
      font-size: .78rem; font-weight: 700;
      color: #92400e; letter-spacing: .06em; text-transform: uppercase;
    }

    /* Gold button */
    .btn-gold {
      display: inline-flex; align-items: center; gap: 8px;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #fff; font-family: var(--font-body);
      font-size: .88rem; font-weight: 700;
      padding: 11px 22px; border-radius: 8px; border: none;
      cursor: pointer; box-shadow: 0 2px 12px rgba(217,119,6,.35);
      transition: all .18s; text-decoration: none;
    }
    .btn-gold:hover {
      background: linear-gradient(135deg, #d97706, #b45309);
      box-shadow: 0 4px 18px rgba(217,119,6,.45);
      transform: translateY(-1px); color: #fff; text-decoration: none;
    }

    /* Nav premium pill */
    .nav-premium-pill {
      font-size: .78rem; font-weight: 700;
      background: linear-gradient(90deg, #fef3c7, #fde68a);
      color: #92400e; border: 1px solid var(--gold-border);
      padding: 5px 12px; border-radius: 20px;
      transition: all .15s; text-decoration: none;
    }
    .nav-premium-pill:hover { background: #f59e0b; color: #fff; text-decoration: none; }

    /* Free badge in hero */
    .hero-free-tag {
      font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
      background: rgba(28,169,106,.2); color: #6ee7b7;
      padding: 5px 12px; border-radius: 20px; border: 1px solid rgba(28,169,106,.35);
    }

    /* Risk table row accent borders */
    .risk-table tbody tr.row-critical td:first-child { border-left: 3px solid var(--red); }
    .risk-table tbody tr.row-high     td:first-child { border-left: 3px solid var(--orange); }
    .risk-table tbody tr.row-medium   td:first-child { border-left: 3px solid var(--amber); }
    .risk-table tbody tr.row-low      td:first-child { border-left: 3px solid var(--green); }

    /* Compare wrap: red/green side borders */
    .compare-col.have { border-left: 4px solid var(--red); }
    .compare-col.need { border-right: 4px solid var(--green); }

    /* Locked stage tab */
    .stage-locked {
      cursor: default !important; background: #fffbeb !important;
      border-color: var(--gold-border) !important;
    }
    .stage-locked .stage-num  { background: #fef3c7; color: #92400e; border: 1px solid var(--gold-border); }
    .stage-locked .stage-name { color: #92400e; }
    .stage-locked .stage-sub  { color: #a16207; }
    .stage-lock-icon { font-size: .8rem; position: absolute; top: 10px; right: 10px; }

    /* Premium tooltip */
    [data-premium-tooltip] { position: relative; cursor: pointer; }
    [data-premium-tooltip]::after {
      content: attr(data-premium-tooltip);
      position: absolute; bottom: 120%; left: 50%; transform: translateX(-50%);
      background: linear-gradient(135deg, #78350f, #92400e); color: #fef3c7;
      font-size: .76rem; font-family: var(--font-body); font-weight: 500;
      padding: 8px 14px; border-radius: 8px; white-space: normal;
      pointer-events: none; opacity: 0; transition: opacity .2s;
      max-width: 220px; text-align: center;
      box-shadow: 0 4px 16px rgba(120,53,15,.4); z-index: 200;
      border: 1px solid rgba(253,211,77,.4);
    }
    [data-premium-tooltip]:hover::after { opacity: 1; }

    /* Alert gold */
    .alert-gold { background: #fffbeb; border-color: var(--gold-border); color: #92400e; }

    /* ══════════════════════════════════════════════
       CTA SECTION  [v2 new]
    ══════════════════════════════════════════════ */
    #cta {
      background: linear-gradient(135deg, #0d1117 0%, #0f1f3d 60%, #0a2010 100%);
      color: #fff; padding: 80px 0; position: relative; overflow: hidden;
    }
    #cta::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 60% 60% at 20% 50%, rgba(26,110,245,.18), transparent),
                  radial-gradient(ellipse 50% 50% at 80% 40%, rgba(28,169,106,.12), transparent);
    }
    #cta .container { position: relative; }
    .cta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }

    .cta-free h3  { font-size: 1.45rem; margin-bottom: 12px; color: #fff; }
    .cta-free p   { font-size: .94rem; color: #8899aa; margin-bottom: 24px; line-height: 1.65; }
    .download-card {
      background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12);
      border-radius: var(--radius-lg); padding: 20px;
      display: flex; gap: 14px; align-items: center;
    }
    .dl-icon { font-size: 2rem; flex-shrink: 0; }
    .dl-info h4 { font-size: .92rem; color: #fff; margin-bottom: 3px; }
    .dl-info p  { font-size: .8rem; color: #6b7a8d; }
    .btn-download {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--green); color: #fff;
      font-family: var(--font-body); font-size: .88rem; font-weight: 700;
      padding: 11px 20px; border-radius: 8px; border: none;
      cursor: pointer; transition: all .18s; text-decoration: none; margin-top: 16px;
    }
    .btn-download:hover { background: #16a35a; color: #fff; text-decoration: none; transform: translateY(-1px); }

    .cta-premium h3 { font-size: 1.45rem; margin-bottom: 12px; }
    .cta-premium h3 span { color: #f59e0b; }
    .cta-premium p  { font-size: .94rem; color: #8899aa; margin-bottom: 22px; line-height: 1.65; }

    .premium-features { list-style: none; margin-bottom: 26px; }
    .premium-features li {
      display: flex; align-items: flex-start; gap: 10px;
      font-size: .87rem; color: #c5d5e8; padding: 7px 0;
      border-bottom: 1px solid rgba(255,255,255,.07);
    }
    .premium-features li:last-child { border-bottom: none; }
    .pf-icon { flex-shrink: 0; font-size: .95rem; margin-top: 2px; }

    .email-form { display: flex; gap: 10px; flex-wrap: wrap; }
    .email-input {
      flex: 1; min-width: 200px;
      background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.2);
      border-radius: 8px; padding: 12px 16px;
      color: #fff; font-family: var(--font-body); font-size: .9rem;
      outline: none; transition: border-color .15s;
    }
    .email-input::placeholder { color: #556677; }
    .email-input:focus { border-color: var(--gold-border); }
    .form-note { font-size: .74rem; color: #556677; margin-top: 9px; }

    .form-confirm { display: none; }
    .form-confirm.visible { display: flex; align-items: center; gap: 12px; }
    .form-confirm-text { font-size: .9rem; color: #6ee7b7; }

    @media (max-width: 900px) { .cta-grid { grid-template-columns: 1fr; gap: 40px; } }
    @media (max-width: 768px) { .email-form { flex-direction: column; } }


    /* ═══════════════════════════════════════════════
       UNLOCK PREMIUM SECTION  [v2.1]
    ═══════════════════════════════════════════════ */
    #unlock {
      background: var(--surface);
      padding: 80px 0;
      border-top: 1px solid var(--border);
    }
    .unlock-head {
      text-align: center;
      margin-bottom: 52px;
    }
    .unlock-head .label { margin-bottom: 10px; }
    .unlock-head h2 {
      font-size: clamp(1.9rem, 3.5vw, 2.6rem);
      margin-bottom: 14px;
    }
    .unlock-head h2 em { font-style: normal; color: var(--blue); }
    .unlock-head p {
      font-size: 1rem; color: var(--ink-soft);
      max-width: 560px; margin: 0 auto;
    }

    /* Two-column card grid */
    .unlock-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      align-items: stretch;
    }

    /* Individual pathway card */
    .unlock-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 32px 28px 28px;
      display: flex;
      flex-direction: column;
      gap: 0;
      box-shadow: var(--shadow);
      position: relative;
      overflow: hidden;
      transition: box-shadow .2s, transform .2s;
    }
    .unlock-card:hover {
      box-shadow: var(--shadow-lg);
      transform: translateY(-3px);
    }
    /* Coloured top stripe per card */
    .unlock-card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 4px;
    }
    .unlock-card.card-email::before  { background: var(--blue); }
    .unlock-card.card-buy::before    { background: linear-gradient(90deg, #f59e0b, #d97706); }
    .unlock-card.card-consult::before { background: var(--green); }

    /* Icon circle */
    .unlock-icon {
      width: 52px; height: 52px;
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.6rem;
      margin-bottom: 20px;
      flex-shrink: 0;
    }
    .unlock-card.card-email   .unlock-icon { background: var(--blue-pale); }
    .unlock-card.card-buy     .unlock-icon { background: #fef3c7; }
    .unlock-card.card-consult .unlock-icon { background: var(--green-pale); }

    /* "Most Popular" badge on buy card */
    .popular-badge {
      position: absolute; top: 16px; right: 16px;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #fff; font-size: .68rem; font-weight: 700;
      letter-spacing: .08em; text-transform: uppercase;
      padding: 4px 10px; border-radius: 20px;
    }

    .unlock-card h3 {
      font-size: 1.08rem;
      margin-bottom: 10px;
      color: var(--ink);
    }
    .unlock-card p {
      font-size: .88rem;
      color: var(--ink-soft);
      line-height: 1.6;
      flex: 1;
      margin-bottom: 24px;
    }

    /* Feature micro-list inside each card */
    .unlock-features {
      list-style: none;
      margin-bottom: 24px;
    }
    .unlock-features li {
      font-size: .82rem;
      color: var(--ink-soft);
      padding: 5px 0;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: flex-start; gap: 7px;
    }
    .unlock-features li:last-child { border-bottom: none; }
    .unlock-features li::before {
      content: '✓';
      flex-shrink: 0;
      font-weight: 700;
      margin-top: 1px;
    }
    .unlock-card.card-email   .unlock-features li::before { color: var(--blue); }
    .unlock-card.card-buy     .unlock-features li::before { color: var(--amber); }
    .unlock-card.card-consult .unlock-features li::before { color: var(--green); }

    /* CTA buttons — per pathway colour */
    .btn-unlock {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      width: 100%;
      font-family: var(--font-body); font-size: .92rem; font-weight: 700;
      padding: 13px 20px; border-radius: 9px; border: none;
      cursor: pointer; transition: all .18s; text-decoration: none;
      margin-top: auto;
    }
    .btn-unlock-email {
      background: var(--blue); color: #fff;
    }
    .btn-unlock-email:hover  { background: #1558d0; color: #fff; text-decoration: none; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(26,110,245,.35); }
    .btn-unlock-buy {
      background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff;
      box-shadow: 0 2px 12px rgba(217,119,6,.3);
    }
    .btn-unlock-buy:hover    { background: linear-gradient(135deg, #d97706, #b45309); color: #fff; text-decoration: none; transform: translateY(-1px); box-shadow: 0 4px 18px rgba(217,119,6,.45); }
    .btn-unlock-consult {
      background: var(--green); color: #fff;
    }
    .btn-unlock-consult:hover { background: #16a35a; color: #fff; text-decoration: none; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(28,169,106,.35); }

    /* Divider line between icon options */
    .unlock-divider {
      display: flex; align-items: center; gap: 12px;
      margin: 40px 0 32px;
      color: var(--ink-muted); font-size: .8rem; font-weight: 500;
    }
    .unlock-divider::before,
    .unlock-divider::after {
      content: ''; flex: 1; height: 1px; background: var(--border);
    }

    /* Footer upgrade note */
    .unlock-footer-note {
      text-align: center;
      margin-top: 40px;
      font-size: .84rem;
      color: var(--ink-muted);
    }
    .unlock-footer-note a {
      color: var(--amber); font-weight: 600;
    }
    .unlock-footer-note a:hover { text-decoration: underline; }

    /* Email capture sub-form inside card */
    .inline-email-form {
      display: flex; flex-direction: column; gap: 8px;
      margin-top: auto;
    }
    .inline-email-input {
      width: 100%;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 8px; padding: 11px 14px;
      color: var(--ink); font-family: var(--font-body); font-size: .88rem;
      outline: none; transition: border-color .15s;
    }
    .inline-email-input::placeholder { color: var(--ink-muted); }
    .inline-email-input:focus { border-color: var(--blue); }

    .inline-confirm { display: none; }
    .inline-confirm.visible {
      display: flex; align-items: center; gap: 8px;
      font-size: .86rem; color: var(--green); font-weight: 500;
      padding: 10px 0;
    }

    /* Responsive */
    @media (max-width: 720px) {
      .unlock-grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; }
    }


    /* ── Free download banner inside #unlock ── */
    .free-download-banner {
      background: var(--card);
      border: 1px solid var(--border);
      border-left: 4px solid var(--green);
      border-radius: var(--radius-lg);
      padding: 24px 28px;
      display: flex; align-items: center;
      justify-content: space-between; gap: 24px;
      box-shadow: var(--shadow);
      margin-bottom: 0;
      flex-wrap: wrap;
    }
    .fdb-left { flex: 1; min-width: 240px; }
    .fdb-left h4 { font-family: var(--font-head); font-size: 1.05rem; margin-bottom: 6px; }
    .fdb-left p  { font-size: .86rem; color: var(--ink-soft); line-height: 1.55; }
    .fdb-right { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }

    /* Or divider between download banner and cards */
    .unlock-or-divider {
      display: flex; align-items: center; gap: 16px;
      margin: 32px 0;
      color: var(--ink-muted); font-size: .82rem; font-weight: 600;
      letter-spacing: .06em; text-transform: uppercase;
    }
    .unlock-or-divider::before,
    .unlock-or-divider::after {
      content: ''; flex: 1; height: 1px; background: var(--border);
    }


    /* ══════════════════════════════════════════════
       SPRINT CTA BLOCK  [premium]
    ══════════════════════════════════════════════ */
    .sprint-cta-block {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      background: linear-gradient(135deg, #f0f9ff, #e6f8ef);
      border: 1px solid #86efac;
      border-left: 4px solid var(--green);
      border-radius: var(--radius);
      padding: 18px 20px;
      margin-top: 24px;
      flex-wrap: wrap;
    }
    .sprint-cta-text {
      font-size: .88rem;
      color: var(--ink-soft);
      flex: 1;
      min-width: 200px;
    }
    .sprint-cta-text strong { color: var(--ink); }
    .btn-sprint {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--green);
      color: #fff;
      font-family: var(--font-body);
      font-size: .85rem;
      font-weight: 700;
      padding: 11px 20px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      transition: all .18s;
      flex-shrink: 0;
    }
    .btn-sprint:hover {
      background: #16a35a;
      color: #fff;
      text-decoration: none;
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(28,169,106,.35);
    }
    @media (max-width: 640px) {
      .sprint-cta-block { flex-direction: column; align-items: flex-start; }
      .btn-sprint { width: 100%; justify-content: center; }
    }
    @media print { .sprint-cta-block { display: none !important; } }


    /* ══════════════════════════════════════════════
       SCROLL PROGRESS BAR
    ══════════════════════════════════════════════ */
    #scroll-progress {
      position: fixed;
      top: 0; left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--blue), #7c3aed);
      z-index: 9999;
      transition: width .1s linear;
      pointer-events: none;
    }

    /* ══════════════════════════════════════════════
       MOBILE BOTTOM BAR
    ══════════════════════════════════════════════ */
    #mobile-cta-bar {
      display: none;
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: rgba(13,17,23,.96);
      backdrop-filter: blur(10px);
      border-top: 1px solid rgba(255,255,255,.1);
      padding: 12px 16px;
      z-index: 200;
      gap: 10px;
      align-items: center;
      justify-content: space-between;
    }
    #mobile-cta-bar .mob-brand {
      font-family: var(--font-head);
      font-size: .78rem;
      color: #8899aa;
      flex: 1;
