on:
  pull_request:
    branches: [main, develop]
    paths:
      - 'compliance/**'
      - 'models/**'
      - 'datasets/**'

jobs:
  validate-technical-file:
    name: Validate Annex IV Technical File
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install AJV CLI
        run: npm install -g ajv-cli ajv-formats

      - name: Validate Technical File schema
        run: |
          ajv validate \
            -s compliance/schemas/technical-file.schema.json \
            -d compliance/technical-file.json \
            --spec=draft7 \
            --all-errors
        # Fails PR if Technical File is missing required fields

      - name: Validate Art. 12 Log Schema
        run: |
          ajv validate \
            -s compliance/schemas/art12-event-log.schema.json \
            -d compliance/art12-log-sample.json \
            --spec=draft7

      - name: Validate Dataset Card
        run: |
          ajv validate \
            -s compliance/schemas/dataset-card.schema.json \
            -d datasets/${{ github.event.pull_request.head.ref }}/dataset-card.json \
            --spec=draft7

  check-version-history:
    name: Check Technical File version history updated
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 2

      - name: Verify version_history entry added
        run: |
          python3 - <<'EOF'
          import json, sys
          with open("compliance/technical-file.json") as f:
              tf = json.load(f)
          history = tf.get("version_history", [])
          if not history:
              print("ERROR: version_history is empty. Every change requires a risk-linked entry.")
              sys.exit(1)
          latest = history[-1]
          required = ["version", "date", "author", "changes", "risk_delta"]
          missing = [k for k in required if not latest.get(k)]
          if missing:
              print(f"ERROR: Latest version_history entry missing fields: {missing}")
              sys.exit(1)
          print(f"OK: version_history updated to {latest['version']} by {latest['author']}")
          EOF

  generate-compliance-report:
    name: Generate Compliance Summary
    runs-on: ubuntu-latest
    needs: [validate-technical-file, check-version-history]
    if: success()
    steps:
      - uses: actions/checkout@v4

      - name: Generate report artifact
        run: |
          python3 - <<'EOF'
          import json
          from datetime import datetime
          with open("compliance/technical-file.json") as f:
              tf = json.load(f)
          report = {
              "generated": datetime.utcnow().isoformat() + "Z",
              "system_id": tf.get("system_id"),
              "system_name": tf.get("system_name"),
              "risk_level": tf.get("risk_classification", {}).get("risk_level"),
              "technical_file_version": tf.get("version_history", [{}])[-1].get("version"),
              "validation_status": "PASSED",
              "ci_run_url": "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
          }
          with open("compliance-report.json", "w") as f:
              json.dump(report, f, indent=2)
          print(json.dumps(report, indent=2))
          EOF

      - name: Upload compliance report
        uses: actions/upload-artifact@v4
        with:
          name: compliance-report-${{ github.sha }}
          path: compliance-report.json
          retention-days: 365  # Retain for audit trail</pre>

