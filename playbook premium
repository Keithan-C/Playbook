      /* Update <html lang> attribute + page title */
      document.documentElement.lang = lang;
      if (t['page_title']) document.title = t['page_title'];

      /* Update active button state */
      document.getElementById('btn-en').classList.toggle('active', lang === 'en');
      document.getElementById('btn-de').classList.toggle('active', lang === 'de');

      /* Persist preference */
      try { localStorage.setItem('playbook_lang', lang); } catch(e) {}
    }

    /* Restore saved preference on load */
    document.addEventListener('DOMContentLoaded', function() {
      try {
        var saved = localStorage.getItem('playbook_lang');
        if (saved && saved !== 'en') setLang(saved);
      } catch(e) {}
    });

    /* ─────────────────────────────────────────────
       7. SELF-DOWNLOAD
       Grabs the current page's HTML and triggers a
       browser download — works locally and on GitHub Pages
    ───────────────────────────────────────────── */
    function downloadPlaybook() {
      /* Expand collapsed tool sections */
      document.querySelectorAll('.tool-body').forEach(function(el) {
        el._wasHidden = (el.style.display === 'none' || el.style.display === '');
        el.style.display = 'block';
      });
      /* Temporarily hide premium overlays so content prints */
      document.querySelectorAll('.premium-overlay').forEach(function(el) {
        el._origDisplay = el.style.display;
        el.style.display = 'none';
      });
      document.querySelectorAll('.premium-content').forEach(function(el) {
        el._origFilter = el.style.filter;
        el.style.filter = 'none';
        el.style.userSelect = 'auto';
      });

      window.print();

      /* Restore UI after print dialog closes */
      setTimeout(function() {
        document.querySelectorAll('.tool-body').forEach(function(el) {
          if (el._wasHidden) el.style.display = '';
        });
        document.querySelectorAll('.premium-overlay').forEach(function(el) {
          el.style.display = el._origDisplay || '';
        });
        document.querySelectorAll('.premium-content').forEach(function(el) {
          el.style.filter = el._origFilter || '';
          el.style.userSelect = '';
        });
      }, 3000);
    }

    /* ─────────────────────────────────────────────
       9. QUICK QUESTION — gap selector + Formspree
    ───────────────────────────────────────────── */
    var _qqGap = '';

    function selectGap(btn) {
      document.querySelectorAll('.qq-option').forEach(function(b) { b.classList.remove('selected'); });
      btn.classList.add('selected');
      _qqGap = btn.getAttribute('data-val');
      /* Enable submit once a gap is chosen */
      var emailEl = document.getElementById('qqEmail');
      if (emailEl && emailEl.value.trim()) {
        document.getElementById('qqSubmit').disabled = false;
      }
    }

    /* Also enable submit when email is typed (if gap already selected) */
    document.addEventListener('DOMContentLoaded', function() {
      var emailEl = document.getElementById('qqEmail');
      if (emailEl) {
        emailEl.addEventListener('input', function() {
          document.getElementById('qqSubmit').disabled = !(this.value.trim() && _qqGap);
        });
      }
    });

    function submitQuickQ() {
      var email = document.getElementById('qqEmail').value.trim();
      if (!email || !_qqGap) return;

      var btn = document.getElementById('qqSubmit');
      btn.disabled = true;
      btn.textContent = '...';

      fetch('https://formspree.io/f/mgonkvnn', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          _subject: 'Playbook gap answer: ' + _qqGap,
          email: email,
          compliance_gap: _qqGap,
          source: 'Quick Question Card — AI Governance Playbook'
        })
      })
      .then(function(r) {
        if (r.ok) {
          document.getElementById('qqConfirm').classList.add('visible');
          document.getElementById('qqOptions').style.opacity = '.4';
          document.getElementById('qqEmail').style.display = 'none';
          btn.style.display = 'none';
        } else {
          btn.disabled = false;
          btn.textContent = 'Try again';
        }
      })
      .catch(function() {
        btn.disabled = false;
        btn.textContent = 'Try again';
      });
    }

    /* ─────────────────────────────────────────────
       10. SCROLL PROGRESS BAR
    ───────────────────────────────────────────── */
    (function() {
      var bar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', function() {
        var scrolled = document.documentElement.scrollTop || document.body.scrollTop;
        var total = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        bar.style.width = (total > 0 ? (scrolled / total * 100) : 0) + '%';
      }, { passive: true });
    })();

  </script>

