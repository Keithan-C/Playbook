from opentelemetry import trace
from opentelemetry.sdk.trace import TracerProvider
from opentelemetry.sdk.trace.export import BatchSpanProcessor
from opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter
import uuid, hashlib, json
from datetime import datetime, timezone

tracer = trace.get_tracer("adas.art12.logger", schema_url="art12-event-log.schema.json")

def log_ai_decision(decision_type, confidence, override_flag,
                    model_version, session_id, vehicle_state,
                    prev_chain_hash="GENESIS"):
    event_id = str(uuid.uuid4())
    timestamp = datetime.now(timezone.utc).isoformat()
    chain_hash = hashlib.sha256(
        f"{prev_chain_hash}{event_id}{timestamp}".encode()
    ).hexdigest()

    with tracer.start_as_current_span("art12.decision") as span:
        span.set_attribute("event_id",      event_id)
        span.set_attribute("session_id",    session_id)
        span.set_attribute("model_version", model_version)
        span.set_attribute("decision_type", decision_type)
        span.set_attribute("confidence",    confidence)
        span.set_attribute("override_flag", override_flag)
        span.set_attribute("chain_hash",    chain_hash)
        for k, v in vehicle_state.items():
            span.set_attribute(f"vehicle_state.{k}", str(v))
    return chain_hash  # pass to next call</pre>

